# Local development: npm run dev uses file:data/hostel.db and explicit development demo accounts.
# To disable demo accounts before creating a NEW local database:
# DEMO_MODE=false

# Vercel / production: persistent hosted libSQL (e.g. Turso). Never use VITE_ names for secrets.
# DATABASE_URL=libsql://your-database-host.turso.io
# DATABASE_AUTH_TOKEN=

# Initial administrator, created only if no active administrator exists. Use secure environment settings.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_PASSWORD must contain at least 12 characters. Remove the bootstrap password after setup.

# Public HTTPS address, used for private tracking links in email.
# APP_URL=https://your-project.vercel.app

# Optional email provider. Sender must be verified with Resend.
# RESEND_API_KEY=
# NOTIFICATION_FROM=YEREVANHUB <bookings@your-verified-domain.com>

# Optional Telegram manager alerts. No guest contacts or private links are sent to the shared chat.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional authenticated notification retry scheduler:
# GET /api/app?worker=notifications with Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Property images: local on persistent servers; blob on Vercel.
# MEDIA_STORAGE=local
# MEDIA_DIRECTORY=data/uploads
# MEDIA_STORAGE=blob
# BLOB_READ_WRITE_TOKEN=

# Optional server-side free-text translation (never prefix this key with VITE_).
# GEMINI_API_KEY=
# TRANSLATION_MODEL=gemini-2.5-flash
