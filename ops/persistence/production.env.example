# Adopt only AFTER discovering/copying/verifying the existing database and media.
# Keep existing application settings/credentials; change only reviewed storage paths.
APP_ENV=production
NODE_ENV=production
DEMO_MODE=false
HOST=127.0.0.1
PORT=3001
APP_URL=https://yerevanhub.ir
PERSISTENT_STORAGE_MODE=managed
REQUIRE_MIGRATION_BACKUP=true
DATABASE_URL=file:/opt/hostel2/data/hostel.db
MEDIA_STORAGE=local
MEDIA_DIRECTORY=/opt/hostel2/media
BACKUP_DIRECTORY=/opt/hostel2/backups
BACKUP_MAX_BYTES=67108864
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_MIN_COUNT=7
# Set a NEW 32-byte base64 key only if no existing recovery key is in use.
# Preserve old keys separately to keep historical archives recoverable.
BACKUP_ENCRYPTION_KEY=
