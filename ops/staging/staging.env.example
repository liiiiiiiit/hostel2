# Staging only. Never copy production .env or credentials.
APP_ENV=staging
NODE_ENV=production
DEMO_MODE=false
HOST=127.0.0.1
PORT=3002
APP_URL=https://test.yerevanhub.ir
DATABASE_URL=file:/opt/hostel2-staging/data/staging.db
DATABASE_AUTH_TOKEN=
MEDIA_STORAGE=local
MEDIA_DIRECTORY=/opt/hostel2-staging/data/uploads
BACKUP_DIRECTORY=/opt/hostel2-staging/backups
# Generate a NEW key: openssl rand -base64 32. Keep it separately from backups.
BACKUP_ENCRYPTION_KEY=
ADMIN_EMAIL=admin@test.yerevanhub.ir
# Generate a NEW password (12–128 characters). May be removed after bootstrap.
ADMIN_PASSWORD=
TRUST_PROXY=loopback
NOTIFICATION_DELIVERY=disabled
HTTP_TEST_MODE=false
RESEND_API_KEY=
NOTIFICATION_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
BLOB_READ_WRITE_TOKEN=
SMS_API_KEY=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_SECRET=
CRON_SECRET=
