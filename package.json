{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --project api/tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts server/*.test.ts",
    "start": "NODE_ENV=production tsx server/dev.ts",
    "test:browser": "node scripts/browser-smoke.mjs",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/backup.ts restore",
    "db:migrate": "node --import tsx scripts/database.ts migrate",
    "db:status": "node --import tsx scripts/database.ts status",
    "db:check": "node --import tsx scripts/database.ts check",
    "db:rollback": "node --import tsx scripts/database.ts rollback"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
