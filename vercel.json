{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "functions": {
    "api/app.ts": {
      "maxDuration": 30,
      "includeFiles": "dist/index.html"
    }
  },
  "git": {
    "deploymentEnabled": {
      "codex/property-management-workflow": false,
      "codex/01-staging-environment": false,
      "codex/02-persistence-backup-recovery": false,
      "codex/03-demo-data-manager": false
    }
  },
  "rewrites": [
    {
      "source": "/api/services/:path*",
      "destination": "/api/app?servicePath=/api/services/:path*"
    },
    {
      "source": "/api/admin/services/:path*",
      "destination": "/api/app?servicePath=/api/admin/services/:path*"
    },
    {
      "source": "/api/admin/service-categories/:path*",
      "destination": "/api/app?servicePath=/api/admin/service-categories/:path*"
    },
    {
      "source": "/api/admin/service-requests/:path*",
      "destination": "/api/app?servicePath=/api/admin/service-requests/:path*"
    },
    {
      "source": "/api/service-categories",
      "destination": "/api/app?servicePath=/api/service-categories"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/app?publicPath=/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/app?publicPath=/robots.txt"
    },
    {
      "source": "/:lang(fa|en|ru|hy)/:path*",
      "destination": "/api/app?publicPath=/:lang/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/services",
      "destination": "/fa/services",
      "permanent": false
    },
    {
      "source": "/services/:slug",
      "destination": "/fa/services/:slug",
      "permanent": false
    }
  ]
}
